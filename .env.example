OPENAI_API_KEY=
AI_TUTOR_MODEL=
AI_REVIEW_MODEL=
SUPABASE_SECRET_KEY=
# A TLS Postgres connection using a login granted scriblune_server (not postgres).
DATABASE_URL=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Scriblune <verify@mail.scriblune.com>
# Generate once with: openssl rand -hex 32. Keep stable between deploys.
# Also encrypts authenticator seeds. Keep stable across redeploys.
AUTH_SECRET=
# Web only. Requires approved free-provider setup; never expose this key to the browser.
VPN_CHECK_MODE=off
PROXYCHECK_API_KEY=
SUPPORT_EMAIL=
# Billing keys must be from the same Stripe mode. Test checkout is staff-only.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Provisioned by scripts/configure-billing.ts; never commit the real values.
STRIPE_PRODUCT_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_ENDPOINT_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_CHANGE_CONFIGURATIONS=
STRIPE_CATALOG_MODE=

# Optional for a manually configured native server. npm run deploy configures
# these automatically with a dedicated VM key, mounted only into the web app.
# CONSOLE_SSH_HOST=host.docker.internal
# CONSOLE_SSH_USER=opc
# CONSOLE_SSH_KEY_FILE=/run/scriblune-console/owner_ed25519
# CONSOLE_SSH_HOST_SHA256=<64-character SHA256 hex of the trusted Ed25519 host key>

# Operator-only, never provide to the web or document worker.
# Put these in .env.operator.local only (ignored by Next):
# GOVERNANCE_DATABASE_URL=
# GOVERNANCE_MAINTENANCE=false

# Proposed provisional limits: keep off until the broader restriction is approved.
# Requires FREE_TIER_GUARD_MODE=enforce. Controls new provisional decisions.
FREE_TIER_PROVISIONAL_MODE=off
