# Copy to .env.deploy.local (ignored). SSH must work non-interactively.
DEPLOY_HOST=ubuntu@YOUR_VM_IP
DEPLOY_DIR=/home/ubuntu/scriblune
# Optional; otherwise SSH uses your agent/config. Never paste a private key here.
DEPLOY_SSH_KEY=
# Point this DNS-only A record at your VM. Open TCP 80/443 for HTTPS.
APP_ORIGIN=https://origin.scriblune.com
# This domain must belong to your Cloudflare account; deploy adds its Worker route.
APP_PUBLIC_URL=https://scriblune.com
